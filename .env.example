# LUVIPRO native B2B device ordering (example only; no keys in Git)
# All transactional features are DISABLED by default.
#
# Optional: Receive non-binding device requests directly on the website via Resend.
# Until enabled, customers can open a pre-filled email in their own mail client.
STORE_PREORDERS_ENABLED=false
RESEND_API_KEY=
STORE_FROM_EMAIL=
STORE_ORDER_EMAIL=customerservice@luvipro.de

# Optional: Stripe Checkout for direct purchases, disabled until approved.
# Configure a SINGLE active, one-time 3000.00 EUR price with tax_behavior=exclusive.
# Configure a Germany shipping rate and Stripe Tax before enabling.
STORE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SHIPPING_RATE_ID=
STRIPE_WEBHOOK_SECRET=
