# LUVIPRO integrated device ordering – example only, no real passwords in Git.
# Disabled until SMTP is tested in the Vercel Preview environment.
STORE_PREORDERS_ENABLED=false

# Hostinger Email: secure SMTP is fixed to smtp.hostinger.com:465 (SSL/TLS).
# Use the FULL email address of the existing Hostinger mailbox.
SMTP_USER=customerservice@luvipro.de
SMTP_PASSWORD=
STORE_ORDER_EMAIL=customerservice@luvipro.de

# Stripe direct purchases: independent and OFF by default.
# Configure a one-time active EUR 3,000.00 net exclusive-tax Stripe price.
# Germany shipping is always EUR 29.99 net per order, set on server.
STORE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
