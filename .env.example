# LUVIPRO integrated device ordering – example only, no real passwords in Git.
# Disabled until SMTP is tested in the Vercel Preview environment.
STORE_PREORDERS_ENABLED=false

# Hostinger Email: secure SMTP is fixed to smtp.hostinger.com:465 (SSL/TLS).
# Use the FULL email address of the existing Hostinger mailbox.
SMTP_USER=customerservice@luvipro.de
SMTP_PASSWORD=
STORE_ORDER_EMAIL=customerservice@luvipro.de

# Stripe direct purchases: independent and OFF by default.
# Configure a one-time active EUR 3,000.00 net exclusive-tax Stripe price.
# Germany shipping is always EUR 29.99 net per order, set on server.
STORE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Invoice issuance: OFF until company registered, correct issuer tax number,
# approved company bank data, Postgres invoice schema and payment tests.
INVOICE_ISSUANCE_ENABLED=false
INVOICE_INTERNAL_TOKEN=
# SUPABASE_URL may already exist in Vercel. NEVER expose service role to client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INVOICE_SELLER_NAME=
INVOICE_SELLER_STREET=
INVOICE_SELLER_PLZ=
INVOICE_SELLER_CITY=
INVOICE_SELLER_TAX_ID=
INVOICE_SELLER_IBAN=
INVOICE_SELLER_BANK_HOLDER=

# PRIVATE internal bookkeeping dashboard (all OFF until separate approval).
ACCOUNTING_PANEL_ENABLED=false
ACCOUNTING_ADMIN_PASSWORD=
ACCOUNTING_SESSION_SECRET=
# Reuses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from invoice issuer.
# Before enabling, install reviewed accounting schema, safe archive storage,
# rate limiting, MFA and logging. Never use NEXT_PUBLIC_ for any secret.
